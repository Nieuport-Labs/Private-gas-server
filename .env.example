# Copy to .env, fill in real values, chmod 600. Never commit .env (see .gitignore).
# See DEPLOY.md for the full pre-launch checklist — several of these have no safe
# default and MUST be set deliberately for a real deployment, not left as-is.

NODE_ENV=production

# --- Chain ---
# Use a Secret-specific host. Generic multi-chain Cosmos providers either lack the compute and
# registration endpoints entirely, or rate-limit hard enough to break a calibration run.
# Verified working 2026-09-17, all four handling 30 rapid requests without a single failure:
#   https://lcd.secret.mainnet.secret3.dev        (default below)
#   https://lcd.secret.tactus.starshell.net
#   https://secret-rest-sl.norm.io
#   https://api.secretnetwork.pathrocknetwork.org
# Directory: https://secretnodes.com/secret-4/endpoints
#
# Before trusting any other endpoint, confirm it serves the enclave IO key that every encrypted
# query depends on:  curl "$LCD_URL/registration/v1beta1/tx-key"  -> {"key":"..."}
# There is no RPC setting — secretjs uses the LCD only.
CHAIN_ID=secret-4
LCD_URL=https://lcd.secret.mainnet.secret3.dev

# Mainnet sSCRT (verified live 2026-09-17 — re-verify before trusting this if it's been a
# while, contracts occasionally migrate; the code hash is always resolved dynamically, never
# hardcoded, so only the address matters here):
SSCRT_CONTRACT=secret1k0jntykt7e4g3y88ltc60czgjuqdy4c9e8fzek

# The Cosmos chain registry gives secret-4 a minimum of 0.05 and an average of 0.1 uscrt, and
# nodes enforce their own minimum on top: lcd.secret.mainnet.secret3.dev rejects anything under
# 0.1 outright ("insufficient fee"). 0.1 is the working value; below it transactions are refused
# by some nodes and merely accepted by others, which is worse than failing outright.
NATIVE_GAS_PRICE_USCRT=0.1

# --- Admin access ---
# Leave EMPTY. The admin password is set through first-run setup in the dashboard, which keeps it
# out of this file and out of your container config entirely. It can be changed later from the
# dashboard without affecting the wallet.
# Setting it here is only a headless bootstrap (CI, devnet, automated rebuilds) and is ignored
# once setup has happened.
ADMIN_PASSWORD=
ADMIN_SESSION_TTL_SECONDS=43200

# --- Provider identity ---
# Optional. Leave EMPTY and generate the wallet from the dashboard instead — it is stored
# encrypted (under ADMIN_PASSWORD) rather than sitting in plaintext in your container config.
# If set, it is adopted into that encrypted store on first boot and can then be removed from here.
PROVIDER_MNEMONIC=

# --- Grant scoping ---
# These, the fee markup, the auto-unwrap settings and the contract whitelist below are all
# editable from the dashboard at runtime. The values here are only the initial ones: once changed
# in the UI the database is the source of truth and editing them here has no further effect.
GRANT_SPEND_LIMIT_USCRT=500000
GRANT_EXPIRY_SECONDS=2592000
# ALLOWED_MESSAGE_TYPES has a sane built-in default (see config.ts) — override only if you want
# to sponsor a narrower or wider set of native message types.

# --- Quote/rate limiting ---
QUOTE_TTL_SECONDS=45
RATE_LIMIT_PER_IP_PER_MINUTE=60
RATE_LIMIT_PER_ADDRESS_PER_MINUTE=10

# --- Fee ---
FEE_MARKUP_PERCENT=10

# --- Auto-unwrap ---
AUTO_UNWRAP_ENABLED=true
AUTO_UNWRAP_THRESHOLD_USCRT=100000000
AUTO_UNWRAP_CHECK_INTERVAL_SECONDS=60

# --- Whitelisted contracts (optional) ---
# Comma-separated. Each address here needs its own calibration run
# (npm run calibrate:contract) before quote.ts will price it.
ALLOWED_CONTRACT_ADDRESSES=

# --- Storage / networking ---
DB_PATH=/var/lib/sscrt-provider/provider.sqlite3
PORT=8787
