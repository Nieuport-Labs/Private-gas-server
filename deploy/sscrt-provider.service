[Unit]
Description=sSCRT gas provider
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sscrt-provider
Group=sscrt-provider
WorkingDirectory=/opt/sscrt-provider/provider-service
EnvironmentFile=/opt/sscrt-provider/provider-service/.env
ExecStart=/usr/bin/node /opt/sscrt-provider/provider-service/dist/index.js
Restart=on-failure
RestartSec=5

# Basic hardening — this process only needs to talk to the network and write its own SQLite
# file under /var/lib/sscrt-provider, nothing else on the filesystem.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/sscrt-provider
ProtectHome=true

[Install]
WantedBy=multi-user.target
